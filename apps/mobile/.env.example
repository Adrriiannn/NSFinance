# Expo client defaults
EXPO_PUBLIC_API_BASE_URL=https://api.finance.nsireland.ie

# EXPO_PUBLIC_* values are visible in the client app bundle. Never place private secrets here.

# Optional Turnstile page host override.
# Keep this pointed at Azure so Turnstile runs under the authorized hostname.
# EXPO_PUBLIC_TURNSTILE_PAGE_BASE_URL=https://api.finance.nsireland.ie

# Google OAuth client IDs (public values).
# Use web + Android IDs so Expo AuthSession can request the correct token audience.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID_PROD=
