# Local Expo development defaults
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_ALLOW_AZURE_IN_DEV=false

# EXPO_PUBLIC_* values are visible in the client app bundle. Never place private secrets here.

# Optional local API override for physical devices on the same LAN.
# Leave unset to use platform defaults in development:
# - Android emulator: http://10.0.2.2:5080
# - iOS simulator: http://localhost:5080
# EXPO_PUBLIC_API_BASE_URL=http://192.168.0.11:5080

# Optional Turnstile page host override.
# Keep this pointed at Azure so Turnstile runs under the production-authorized hostname,
# even when API calls are still routed to local dev.
# EXPO_PUBLIC_TURNSTILE_PAGE_BASE_URL=https://api.finance.nsireland.ie

# Google OAuth client IDs (public values).
# Use web + Android IDs so Expo AuthSession can request the correct token audience.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID_DEBUG=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID_PROD=
