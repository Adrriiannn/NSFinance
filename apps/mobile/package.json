{
  "name": "@nsfinance/mobile",
  "private": true,
  "version": "0.1.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test:node": "tsx --require ../../tools/mobile/Register-NodeTestAssets.cjs --test src/**/*.node.test.ts",
    "expo:check": "expo install --check",
    "expo:doctor": "expo-doctor",
    "production:check": "pwsh -NoProfile -ExecutionPolicy Bypass -File ../../tools/mobile/Test-AndroidRelease.ps1",
    "production:apk": "pwsh -NoProfile -ExecutionPolicy Bypass -File ../../tools/mobile/Invoke-AndroidBuild.ps1 -ArtifactFormat Apk",
    "production:aab": "pwsh -NoProfile -ExecutionPolicy Bypass -File ../../tools/mobile/Invoke-AndroidBuild.ps1 -ArtifactFormat Aab",
    "production:build": "pwsh -NoProfile -ExecutionPolicy Bypass -File ../../tools/mobile/Invoke-AndroidBuild.ps1 -ArtifactFormat Both",
    "production:device": "pwsh -NoProfile -ExecutionPolicy Bypass -File ../../tools/mobile/Invoke-AndroidBuild.ps1 -ArtifactFormat Apk -Install -Launch"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "@tanstack/react-query": "^5.90.7",
    "expo": "~54.0.36",
    "expo-application": "~7.0.8",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.7",
    "expo-linking": "~8.0.12",
    "expo-local-authentication": "~17.0.8",
    "expo-localization": "~17.0.9",
    "expo-location": "~19.0.8",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.7",
    "expo-sharing": "^14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.19",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-blob-util": "^0.24.7",
    "react-native-nitro-google-signin": "1.0.1",
    "react-native-nitro-modules": "0.36.1",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "@types/react": "~19.1.10",
    "@types/zxcvbn": "^4.4.5",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "expo-doctor": "1.20.0",
    "tsx": "4.23.0",
    "typescript": "~5.9.2"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      },
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-nitro-google-signin"
        ]
      }
    }
  }
}
