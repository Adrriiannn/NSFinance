{
  "name": "nsfinance",
  "private": true,
  "packageManager": "pnpm@10.8.0",
  "scripts": {
    "mobile:start": "pnpm --filter @nsfinance/mobile start",
    "mobile:android": "pnpm --filter @nsfinance/mobile android",
    "mobile:ios": "pnpm --filter @nsfinance/mobile ios",
    "mobile:web": "pnpm --filter @nsfinance/mobile web",
    "android:release:check": "pnpm --filter @nsfinance/mobile release:check",
    "android:release:build": "pnpm --filter @nsfinance/mobile release:build",
    "android:release:install": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./tools/mobile/Install-AndroidApk.ps1"
  }
}
